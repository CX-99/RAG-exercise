# Copy to .env and set your key. .env is gitignored.

# Required: both embeddings and answers come from OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hosted models
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=openai/text-embedding-3-small

# Retrieval and generation limits
CORPUS_DIR=data/corpus
RETRIEVAL_TOP_K=5
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
