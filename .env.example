# Defaults run locally with extractive answers; no API key is needed.
LLM_PROVIDER=extractive
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CORPUS_DIR=data/corpus
RETRIEVAL_TOP_K=5
# Calibrated on the bundled 20-question set; see decision 0002.
MIN_RELEVANCE=0.735
LLM_MAX_TOKENS=500
LLM_TIMEOUT_SECONDS=30

# Used only when LLM_PROVIDER=openrouter is explicitly selected.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-20b
LOG_LEVEL=INFO
